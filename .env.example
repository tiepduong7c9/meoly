# Port the Express server listens on (also serves the built SPA in production)
PORT=3001

# Directory where the SQLite cache/accounts DB is stored
DATA_DIR=./data

# 32-byte key (base64) used to encrypt IMAP app passwords at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=

NODE_ENV=development

# ---------------------------------------------------------------------------
# AI triage (optional). Categorizes unread mail and suggests keep / mark_read /
# archive / delete. Provider must be OpenAI-compatible (LMStudio, Ollama, etc).
# Per-account policy (folders, auto-apply) is configured in the app, not here;
# these are the global infra settings + defaults for new accounts.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_API_BASE_URL=http://localhost:1234/v1   # LMStudio default
AI_API_KEY=                                # optional; local servers ignore it
AI_MODEL=local-model

# Global kill-switch: when true, NO IMAP change is made (suggestions only).
# Defaults to true in development, false in production.
AI_DRY_RUN=true

AI_CONCURRENCY=1                           # keep low; shares the IMAP connection
AI_REQUEST_TIMEOUT_MS=60000                # LLMs are slow — be generous
AI_MAX_BODY_CHARS=4000                     # truncate body before sending
AI_POLL_INTERVAL_MS=300000                 # how often to scan for new unread

# Defaults used to seed a new account's per-account settings row.
AI_TARGET_FOLDERS=INBOX                    # comma-separated
AI_AUTO_APPLY=false
AI_AUTO_APPLY_MIN_CONFIDENCE=0.9
AI_AUTO_APPLY_ACTIONS=mark_read            # comma-separated

# Telegram digest + action buttons (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
